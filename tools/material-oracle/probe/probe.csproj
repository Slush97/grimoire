<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev-only reader for the material oracle. Reads game VPKs in place and
       prints texture statistics or streams raw pixels to stdout; it never
       writes game data to disk. Point VrfSrc at a ValveResourceFormat checkout. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <VrfSrc Condition="'$(VrfSrc)' == ''">$(MSBuildThisFileDirectory)../../../.codex-run/vrf-src</VrfSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(VrfSrc)/ValveResourceFormat/ValveResourceFormat.csproj" />
  </ItemGroup>
</Project>
