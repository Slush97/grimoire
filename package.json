{
  "name": "grimoire",
  "private": true,
  "version": "1.33.0",
  "description": "Grimoire - A mod manager for Deadlock",
  "license": "MIT",
  "author": {
    "name": "esoc"
  },
  "type": "module",
  "main": "dist/main/index.js",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "install-electron && node scripts/fetch-vpkmerge.mjs",
    "fetch-vpkmerge": "node scripts/fetch-vpkmerge.mjs",
    "fetch-hero-icons": "node scripts/fetch-hero-icons.mjs",
    "fetch-locker-art": "node scripts/fetch-locker-art.mjs",
    "locker-art:check": "node scripts/fetch-locker-art.mjs --check",
    "generate-hero-chip-icons": "node scripts/generate-hero-chip-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "typecheck": "tsc -b",
    "i18n:check": "node scripts/check-i18n.mjs",
    "ui:check": "node scripts/check-ui.mjs",
    "i18n:manifest": "node scripts/gen-locale-manifest.mjs",
    "perf:presets": "tsx scripts/gen-performance-presets.mjs",
    "i18n:extract-unwired": "node scripts/extract-unwired-i18n.mjs",
    "package": "electron-vite build && electron-builder",
    "package:linux": "electron-vite build && electron-builder --linux",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@compai/font-unifraktur-maguntia": "^0.0.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "@tanstack/react-virtual": "^3.14.20",
    "@xhayper/discord-rpc": "^1.5.1",
    "acorn": "8.15.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.17",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "gifenc": "1.0.3",
    "https-proxy-agent": "^9.1.0",
    "i18next": "^26.4.6",
    "lucide-react": "^1.57.0",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.18",
    "react-router-dom": "^7.18.4",
    "socks-proxy-agent": "^10.1.0",
    "three": "^0.186.1",
    "three-custom-shader-material": "^6.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^10.0.1",
    "@grimoire/social-types": "workspace:*",
    "@react-three/test-renderer": "^9.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "gltfjsx": "^6.5.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "leva": "^0.10.1",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
